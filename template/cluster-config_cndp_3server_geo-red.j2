        <initial-boot>
          <netplan>
            <vlans>
              <device-id>{{cnbng_cp.cluster.networks.k8s.intf}}.k8s.{{cnbng_cp.cluster.networks.k8s.id}}</device-id>
              <addresses>{{cnbng_cp.ucs02.networks.k8s.ip}}</addresses>
              <gateway4>{{cnbng_cp.ucs02.networks.k8s.gateway}}</gateway4>
            </vlans>
            <vlans>
              <device-id>{{cnbng_cp.cluster.networks.mgmt.intf}}.mgmt.{{cnbng_cp.cluster.networks.mgmt.id}}</device-id>
              <addresses>{{cnbng_cp.ucs02.networks.mgmt.ip}}</addresses>
            </vlans>
            <vlans>
              <device-id>{{cnbng_cp.cluster.networks.inttcp.intf}}.inttcp.{{cnbng_cp.cluster.networks.inttcp.id}}</device-id>
              <dhcp4>false</dhcp4>
              <dhcp6>false</dhcp6>
              <addresses>{{cnbng_cp.ucs02.networks.inttcp.ip}}</addresses>
              <routes>
                <to>{{cnbng_cp.ucs02.networks.inttcp.route.to}}</to>
                <via>{{cnbng_cp.ucs02.networks.inttcp.route.via}}</via>
              </routes>
              <id>{{cnbng_cp.cluster.networks.inttcp.id}}</id>
              <link>{{cnbng_cp.cluster.networks.inttcp.intf}}</link>
            </vlans>
            <vlans>
              <device-id>{{cnbng_cp.cluster.networks.cdl.intf}}.cdl.{{cnbng_cp.cluster.networks.cdl.id}}</device-id>
              <dhcp4>false</dhcp4>
              <dhcp6>false</dhcp6>
              <addresses>{{cnbng_cp.ucs02.networks.cdl.ip}}</addresses>
              <routes>
                <to>{{cnbng_cp.ucs02.networks.cdl.route.to}}</to>
                <via>{{cnbng_cp.ucs02.networks.cdl.route.via}}</via>
              </routes>
              <id>{{cnbng_cp.cluster.networks.cdl.id}}</id>
              <link>{{cnbng_cp.cluster.networks.cdl.intf}}</link>
            </vlans>
            <vlans>
              <device-id>{{cnbng_cp.cluster.networks.intudp.intf}}.intudp.{{cnbng_cp.cluster.networks.intudp.id}}</device-id>
              <dhcp4>false</dhcp4>
              <dhcp6>false</dhcp6>
              <addresses>{{cnbng_cp.ucs02.networks.intudp.ip}}</addresses>
              <id>{{cnbng_cp.cluster.networks.intudp.id}}</id>
              <link>{{cnbng_cp.cluster.networks.intudp.intf}}</link>
            </vlans>
            <vlans>
              <device-id>{{cnbng_cp.cluster.networks.n4.intf}}.n4.{{cnbng_cp.cluster.networks.n4.id}}</device-id>
              <dhcp4>false</dhcp4>
              <dhcp6>false</dhcp6>
              <addresses>{{cnbng_cp.ucs02.networks.n4.ip}}</addresses>
              <id>{{cnbng_cp.cluster.networks.n4.id}}</id>
              <link>{{cnbng_cp.cluster.networks.n4.intf}}</link>
            </vlans>
            {% for bgp in cnbng_cp.ucs02.networks.bgp -%}
            <vlans>
              <device-id>{{cnbng_cp.ucs02.networks.bgp[bgp].intf}}.{{cnbng_cp.ucs02.networks.bgp[bgp].id}}</device-id>
              <dhcp4>false</dhcp4>
              <dhcp6>false</dhcp6>
              <addresses>{{cnbng_cp.ucs02.networks.bgp[bgp].ip}}</addresses>
              <id>{{cnbng_cp.ucs02.networks.bgp[bgp].id}}</id>
              <link>{{cnbng_cp.ucs02.networks.bgp[bgp].intf}}</link>
