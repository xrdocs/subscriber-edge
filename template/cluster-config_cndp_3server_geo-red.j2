          </netplan>
        </initial-boot>
        <os>
          <tuned>
            <enabled>true</enabled>
          </tuned>
        </os>
      </nodes>
      <nodes>
        <name>ucs03</name>
        <host-profile>{{images.host_profile.name}}</host-profile>
        <k8s>
          <node-type>master</node-type>
          <ssh-ip>{{cnbng_cp.ucs03.networks.k8s.ip}}</ssh-ip>
          <node-ip>{{cnbng_cp.ucs03.networks.k8s.ip}}</node-ip>
          <node-labels>
            <key>smi.cisco.com/node-type</key>
            <value>oam</value>
          </node-labels>
          <node-labels>
            <key>smi.cisco.com/sess-type</key>
            <value>cdl-node</value>
          </node-labels>
          <node-labels>
            <key>smi.cisco.com/svc-type</key>
            <value>service</value>
          </node-labels>
        </k8s>
        <ucs-server>
          <cimc>
            <user>{{cnbng_cp.ucs03.cimc.user}}</user>
            <password>{{cnbng_cp.ucs03.cimc.password}}</password>
            <ip-address>{{cnbng_cp.ucs03.cimc.ip}}</ip-address>
          </cimc>
        </ucs-server>
        <initial-boot>
          <netplan>
            <vlans>
              <device-id>{{cnbng_cp.cluster.networks.k8s.intf}}.k8s.{{cnbng_cp.cluster.networks.k8s.id}}</device-id>
              <addresses>{{cnbng_cp.ucs03.networks.k8s.ip}}</addresses>
              <gateway4>{{cnbng_cp.ucs03.networks.k8s.gateway}}</gateway4>
            </vlans>
            <vlans>
              <device-id>{{cnbng_cp.cluster.networks.mgmt.intf}}.mgmt.{{cnbng_cp.cluster.networks.mgmt.id}}</device-id>
              <addresses>{{cnbng_cp.ucs03.networks.mgmt.ip}}</addresses>
            </vlans>
            <vlans>
              <device-id>{{cnbng_cp.cluster.networks.cdl.intf}}.cdl.{{cnbng_cp.cluster.networks.cdl.id}}</device-id>
              <dhcp4>false</dhcp4>
              <dhcp6>false</dhcp6>
              <addresses>{{cnbng_cp.ucs03.networks.cdl.ip}}</addresses>
              <routes>
                <to>{{cnbng_cp.ucs03.networks.cdl.route.to}}</to>
                <via>{{cnbng_cp.ucs03.networks.cdl.route.via}}</via>
              </routes>
              <id>{{cnbng_cp.cluster.networks.cdl.id}}</id>
              <link>{{cnbng_cp.cluster.networks.cdl.intf}}</link>
            </vlans>
          </netplan>
        </initial-boot>
      </nodes>
      <virtual-ips>
        <group>cdlvip</group>
        <check-interface>
          <name>{{cnbng_cp.cluster.networks.k8s.intf}}.k8s.{{cnbng_cp.cluster.networks.k8s.id}}</name>
        </check-interface>
        <check-interface>
          <name>{{cnbng_cp.cluster.networks.cdl.intf}}.cdl.{{cnbng_cp.cluster.networks.cdl.id}}</name>
        </check-interface>
        <vrrp-interface>{{cnbng_cp.cluster.networks.cdl.intf}}.cdl.{{cnbng_cp.cluster.networks.cdl.id}}</vrrp-interface>
        <vrrp-router-id>210</vrrp-router-id>
        <ipv4-addresses>
          <addr>{{cnbng_cp.cluster.networks.cdl.vip1}}</addr>
          <mask>24</mask>
          <broadcast>{{cnbng_cp.cluster.networks.cdl.broadcast}}</broadcast>
          <device>{{cnbng_cp.cluster.networks.cdl.intf}}.cdl.{{cnbng_cp.cluster.networks.cdl.id}}</device>
        </ipv4-addresses>
        <ipv4-addresses>
