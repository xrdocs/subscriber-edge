		  <initial-boot>
		  <default-user>cloud-user</default-user>
		  <default-user-ssh-public-key>ssh-rsa  cloud-user@inception</default-user-ssh-public-key>
          <default-user-password>Cisco@123</default-user-password>
          <default-user-password-expiration-days>0</default-user-password-expiration-days>
          <netplan>
            <ethernets>
              <device-id>eno1</device-id>
              <dhcp4>false</dhcp4>
              <dhcp6>false</dhcp6>
            </ethernets>
            <ethernets>
              <device-id>eno2</device-id>
              <dhcp4>false</dhcp4>
              <dhcp6>false</dhcp6>
            </ethernets>
            <ethernets>
              <device-id>eno5</device-id>
              <dhcp4>false</dhcp4>
              <dhcp6>false</dhcp6>
            </ethernets>
            <ethernets>
              <device-id>eno6</device-id>
              <dhcp4>false</dhcp4>
              <dhcp6>false</dhcp6>
            </ethernets>
            <ethernets>
              <device-id>enp216s0f0</device-id>
              <dhcp4>false</dhcp4>
              <dhcp6>false</dhcp6>
            </ethernets>
            <ethernets>
              <device-id>enp216s0f1</device-id>
              <dhcp4>false</dhcp4>
              <dhcp6>false</dhcp6>
            </ethernets>
            <ethernets>
              <device-id>enp94s0f0</device-id>
              <dhcp4>false</dhcp4>
              <dhcp6>false</dhcp6>
            </ethernets>
            <ethernets>
              <device-id>enp94s0f1</device-id>
              <dhcp4>false</dhcp4>
              <dhcp6>false</dhcp6>
            </ethernets>
            {% for bond in cnbng_cp.node_defaults.bond_interfaces -%}
            <bonds>
              <device-id>{{ bond }}</device-id>
              <dhcp4>false</dhcp4>
              <dhcp6>false</dhcp6>
              <optional>true</optional>
              {% for intf in cnbng_cp.node_defaults.bond_interfaces[bond].links %}
              <interfaces>{{intf}}</interfaces>
              {% endfor %}
              <parameters>
                <mode>active-backup</mode>
                <mii-monitor-interval>100</mii-monitor-interval>
                <fail-over-mac-policy>active</fail-over-mac-policy>
              </parameters>
            </bonds>
            {% endfor %}
            <vlans>
              <device-id>{{cnbng_cp.cluster.networks.k8s.intf}}.k8s.{{cnbng_cp.cluster.networks.k8s.id}}</device-id>
              <dhcp4>false</dhcp4>
              <dhcp6>false</dhcp6>
              <id>{{cnbng_cp.cluster.networks.k8s.id}}</id>
              <link>{{cnbng_cp.cluster.networks.k8s.intf}}</link>
            </vlans>
          </netplan>
        </initial-boot>
        <ucs-server>
          <cimc>
            <user>admin</user>
            <storage-adaptor>
              <create-virtual-drive>true</create-virtual-drive>
            </storage-adaptor>
            <remote-management>
              <sol>
                <enabled>true</enabled>
                <baud-rate>115200</baud-rate>
                <comport>com0</comport>
                <ssh-port>2400</ssh-port>
              </sol>
            </remote-management>
            <networking>
              <ntp>
                <enabled>true</enabled>
                <servers>
                  <url>{{cnbng_cp.cluster.ntp}}</url>
                </servers>
              </ntp>
            </networking>
          </cimc>
        </ucs-server>
        <os>
          <ntp>
            <servers>
              <url>{{cnbng_cp.cluster.ntp}}</url>
            </servers>
            <enabled>true</enabled>
          </ntp>
        </os>
      </node-defaults>
      <node-type-defaults>
        <type>master</type>
        <initial-boot>
          <netplan>
            <vlans>
              <device-id>{{cnbng_cp.cluster.networks.mgmt.intf}}.mgmt.{{cnbng_cp.cluster.networks.mgmt.id}}</device-id>
              <nameservers>
                <search>{{cnbng_cp.node_defaults.domain}}</search>
                <addresses>{{cnbng_cp.node_defaults.dns}}</addresses>
              </nameservers>
              <routes>
                <to>{{cnbng_cp.node_defaults.route}}</to>
                <via>{{cnbng_cp.node_defaults.gateway}}</via>
              </routes>
              <id>{{cnbng_cp.cluster.networks.mgmt.id}}</id>
              <link>{{cnbng_cp.cluster.networks.mgmt.intf}}</link>
            </vlans>
          </netplan>
        </initial-boot>
      </node-type-defaults>
      <nodes>
        <name>ucs01</name>
        <host-profile>{{images.host_profile.name}}</host-profile>
        <k8s>
          <node-type>master</node-type>
          <ssh-ip>{{cnbng_cp.ucs01.networks.k8s.ip}}</ssh-ip>
          <node-ip>{{cnbng_cp.ucs01.networks.k8s.ip}}</node-ip>
          <node-labels>
            <key>smi.cisco.com/node-type</key>
            <value>oam</value>
          </node-labels>
          <node-labels>
            <key>smi.cisco.com/proto-type</key>
            <value>protocol</value>
          </node-labels>
          <node-labels>
            <key>smi.cisco.com/protocol</key>
            <value>protocol</value>
          </node-labels>
          <node-labels>
            <key>smi.cisco.com/svc-type</key>
            <value>service</value>
          </node-labels>
        </k8s>
        <ucs-server>
          <cimc>
            <user>{{cnbng_cp.ucs01.cimc.user}}</user>
            <password>{{cnbng_cp.ucs01.cimc.password}}</password>
            <ip-address>{{cnbng_cp.ucs01.cimc.ip}}</ip-address>
          </cimc>
        </ucs-server>
        <initial-boot>
          <netplan>
            <vlans>
              <device-id>{{cnbng_cp.cluster.networks.k8s.intf}}.k8s.{{cnbng_cp.cluster.networks.k8s.id}}</device-id>
              <addresses>{{cnbng_cp.ucs01.networks.k8s.ip}}</addresses>
              <gateway4>{{cnbng_cp.ucs01.networks.k8s.gateway}}</gateway4>
            </vlans>
            <vlans>
              <device-id>{{cnbng_cp.cluster.networks.mgmt.intf}}.mgmt.{{cnbng_cp.cluster.networks.mgmt.id}}</device-id>
              <addresses>{{cnbng_cp.ucs01.networks.mgmt.ip}}</addresses>
            </vlans>
            <vlans>
              <device-id>{{cnbng_cp.cluster.networks.inttcp.intf}}.inttcp.{{cnbng_cp.cluster.networks.inttcp.id}}</device-id>
              <dhcp4>false</dhcp4>
              <dhcp6>false</dhcp6>
              <addresses>{{cnbng_cp.ucs01.networks.inttcp.ip}}</addresses>
              <routes>
                <to>{{cnbng_cp.ucs01.networks.inttcp.route.to}}</to>
                <via>{{cnbng_cp.ucs01.networks.inttcp.route.via}}</via>
              </routes>
              <id>{{cnbng_cp.cluster.networks.inttcp.id}}</id>
              <link>{{cnbng_cp.cluster.networks.inttcp.intf}}</link>
            </vlans>
            <vlans>
              <device-id>{{cnbng_cp.cluster.networks.intudp.intf}}.intudp.{{cnbng_cp.cluster.networks.intudp.id}}</device-id>
              <dhcp4>false</dhcp4>
              <dhcp6>false</dhcp6>
              <addresses>{{cnbng_cp.ucs01.networks.intudp.ip}}</addresses>
              <id>{{cnbng_cp.cluster.networks.intudp.id}}</id>
              <link>{{cnbng_cp.cluster.networks.intudp.intf}}</link>
            </vlans>
            <vlans>
              <device-id>{{cnbng_cp.cluster.networks.n4.intf}}.n4.{{cnbng_cp.cluster.networks.n4.id}}</device-id>
              <dhcp4>false</dhcp4>
              <dhcp6>false</dhcp6>
              <addresses>{{cnbng_cp.ucs01.networks.n4.ip}}</addresses>
              <id>{{cnbng_cp.cluster.networks.n4.id}}</id>
              <link>{{cnbng_cp.cluster.networks.n4.intf}}</link>
            </vlans>
            {% for bgp in cnbng_cp.ucs01.networks.bgp -%}
            <vlans>
              <device-id>{{cnbng_cp.ucs01.networks.bgp[bgp].intf}}.{{cnbng_cp.ucs01.networks.bgp[bgp].id}}</device-id>
              <dhcp4>false</dhcp4>
              <dhcp6>false</dhcp6>
              <addresses>{{cnbng_cp.ucs01.networks.bgp[bgp].ip}}</addresses>
              <id>{{cnbng_cp.ucs01.networks.bgp[bgp].id}}</id>
              <link>{{cnbng_cp.ucs01.networks.bgp[bgp].intf}}</link>
            </vlans>
            {% endfor %}
          </netplan>
        </initial-boot>
        <os>
          <tuned>
            <enabled>true</enabled>
          </tuned>
        </os>
      </nodes>
      <nodes>
        <name>ucs02</name>
        <host-profile>{{images.host_profile.name}}</host-profile>
